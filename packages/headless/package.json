{
  "name": "@vueye-table/headless",
  "version": "3.0.0-alpha.8",
  "description": "Unstyled, accessible Vue components for vueye-table: tables, controls, and spreadsheet grids.",
  "keywords": [
    "data-table",
    "datagrid",
    "headless",
    "spreadsheet",
    "vue"
  ],
  "homepage": "https://github.com/boussadjra/vueye-table#readme",
  "bugs": {
    "url": "https://github.com/boussadjra/vueye-table/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/vueye-table.git",
    "directory": "packages/headless"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package:check": "publint --strict && attw --pack . --profile esm-only",
    "clean": "node ../../scripts/clean-package.mjs"
  },
  "dependencies": {
    "@vueye-table/core": "workspace:*",
    "@vueye-table/vue": "workspace:*"
  },
  "devDependencies": {
    "@vueye-table/typescript-config": "workspace:*",
    "vue": "catalog:vue"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
