{
  "name": "vueye-table",
  "version": "3.0.0-alpha.6",
  "description": "A Vue framework for data tables and spreadsheets: a complete, themeable data table and grid, plus every layer beneath them.",
  "keywords": [
    "data-grid",
    "data-table",
    "spreadsheet",
    "table",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/boussadjra/vueye-table#readme",
  "bugs": {
    "url": "https://github.com/boussadjra/vueye-table/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/vueye-table.git",
    "directory": "packages/vueye-table"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package:check": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./style.css",
    "clean": "node ../../scripts/clean-package.mjs"
  },
  "dependencies": {
    "@vueye-table/core": "workspace:*",
    "@vueye-table/headless": "workspace:*",
    "@vueye-table/styled": "workspace:*",
    "@vueye-table/vue": "workspace:*"
  },
  "devDependencies": {
    "@vueye-table/typescript-config": "workspace:*",
    "vue": "catalog:vue"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
