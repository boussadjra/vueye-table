{
  "name": "@vueye-table/core",
  "version": "3.0.0-alpha.5",
  "description": "Framework-independent data table and spreadsheet engine for vueye-table.",
  "keywords": [
    "data-table",
    "datagrid",
    "framework-independent",
    "spreadsheet",
    "typescript"
  ],
  "homepage": "https://github.com/boussadjra/vueye-table#readme",
  "bugs": {
    "url": "https://github.com/boussadjra/vueye-table/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/vueye-table.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package:check": "publint --strict && attw --pack . --profile esm-only",
    "clean": "node ../../scripts/clean-package.mjs"
  },
  "devDependencies": {
    "@vueye-table/typescript-config": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
