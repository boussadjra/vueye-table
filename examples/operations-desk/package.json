{
  "name": "vueye-operations-desk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 4310",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "test:http": "node scripts/http-acceptance.mjs",
    "test:browser": "playwright test",
    "test:a11y": "playwright test --config playwright.a11y.config.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@vueye-table/core": "3.0.0-rc.1",
    "@vueye-table/headless": "3.0.0-rc.1",
    "@vueye-table/nuxt": "3.0.0-rc.1",
    "@vueye-table/styled": "3.0.0-rc.1",
    "@vueye-table/vue": "3.0.0-rc.1",
    "h3": "1.15.11",
    "nuxt": "4.6.4",
    "vue": "3.5.43",
    "vueye-table": "3.0.0-rc.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.0",
    "deepmerge": "4.3.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.8"
  },
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "pnpm@11.17.0"
}
