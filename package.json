{
  "name": "vueye-table-monorepo",
  "version": "3.0.0-alpha.0",
  "private": true,
  "description": "A Vue framework for data, data tables, and spreadsheets.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "docs:dev": "pnpm --filter @vueye-table/docs dev",
    "playground": "pnpm --filter @vueye-table/playground dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "package:check": "turbo run package:check",
    "check": "oxfmt --check . && oxlint . && tsc -p tsconfig.json && turbo run typecheck && vitest run --coverage && turbo run build && node scripts/check-boundaries.mjs && turbo run package:check",
    "changeset": "changeset",
    "version": "changeset version && oxfmt .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:tooling",
    "@changesets/cli": "catalog:tooling",
    "@types/node": "catalog:node",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/test-utils": "catalog:testing",
    "@vueye-table/core": "workspace:*",
    "@vueye-table/headless": "workspace:*",
    "@vueye-table/nuxt": "workspace:*",
    "@vueye-table/styled": "workspace:*",
    "@vueye-table/vue": "workspace:*",
    "happy-dom": "catalog:testing",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "pnpm": "catalog:tooling",
    "publint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vueye-table": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0"
}
